{
  "description": "pjc harness hooks — 스크립트를 hook 셸에서 직접 실행(자식 셸 재기동 없음 — v1.108.0. 실행 셸은 Claude Code의 powershell 해석을 따름: 실측 pwsh 우선·NoProfile, 스크립트는 5.1 호환 유지); cross-platform; Windows verified, macOS/Linux experimental",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/block-destructive.ps1\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/pre-bash-dispatch.ps1\"; exit $LASTEXITCODE",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/require-plan-for-write.ps1\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/protect-harness.ps1\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/suggest-agents-record.ps1\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/post-write-checks.ps1\"; exit $LASTEXITCODE",
            "timeout": 35
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/warn-version-drift.ps1\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/session-context.ps1\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear|resume|logout|prompt_input_exit|other",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/session-end-cleanup.ps1\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/require-evidence.ps1\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
